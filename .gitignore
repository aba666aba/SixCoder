# 依赖
node_modules/

# 构建产物
dist/
build/
target/
release/

# Python 缓存与虚拟环境
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 运行期产物（均可重建）
_logs/
prototype/workspaces/
prototype/data/proto.db*
prototype/data/api_index.db

# 判据标定用的对照实现（正确/丢写/幂等等，可随时重建，见 docs/27）
_sandbox/

# 研究用的大体积索引库（用 graft_demo/bench_scale.py 重新生成）
graft_demo/work/*.db

# 历史实验工作区（有证据价值的两三个目录单独保留，其余不入库）
projects/exp_*
projects/hq_*
projects/iter*
# 压测产地：每次 bench 都会新生成一批，属于可重建产物，不入库
projects/bench-*
projects/night_mode*/
projects/night_remote*/
projects/night_ladder*/
# 判据跑测试时引擎自己写的临时脚本（每次运行都会重写）
projects/**/_props_run.py
projects/**/.sixcoder/
projects/**/__pycache__/

# 本地配置与密钥（绝对不入库）
llm-config.yml
.env
prototype/data/settings.json
prototype/data/capability.json

# 工具/编辑器杂项
.qwen/
.vscode/
.idea/
*.log
*.bak
*.bak2

# 演示仓库：由 core/demo.py 自动生成（内含自己的 .git，绝不能当 gitlink 提交）
prototype/demo-repo/
projects/author_fresh*/
projects/calc*/
projects/night_localfirst*/
projects/ui_q_demo/

# 自检用的临时目录（每次跑都会重建，绝不入库）
prototype/.tmp/

# 引擎运行期状态：审计留痕 / 健康度 / 规模与自主实证台账（可重建，且含本机绝对路径）
.sixcoder/

# 覆盖率产物（gate_coverage 会把 .coverage 指到 .sixcoder/tmp，这里兜底）
.coverage
.coverage.*
htmlcov/

# 夜班/对照实验的证据工作区（每次运行重建，证据另存 _logs/runs）
projects/night-v*/
projects/night-bodies*/
projects/ab_*/
projects/run-*/
projects/_replay_tmp/

# 开发交接文档（本地保存，不上传云端；对外说明请看 README.md）
开发文档.md

# 夜班/实验生成的工作区（可重建，且含本机绝对路径）
projects/*
!projects/README.md
# 本地 git 内部目录的备份（绝不入库）
.git.corrupt-*
.git.bak*

# 打包工具链（只在本机构建安装包用，不进仓库、不上 GitHub）
/packaging/
/shell/resources/
/dist-installer/
/.cache/

# WorkBuddy 本地项目数据（会话记忆 / 工作日志，不入库）
/.workbuddy/

# 本地交接文档与启动脚本（含本机绝对路径 / 内部运维细节，不上传远端；
# 对外说明一律看 README.md）
/HANDOFF-*.md
/START_NIGHT.bat
/STOP_NIGHT.bat
/bat/
/tools/bat/

# 全量自检输出（本地运行产物，可随时重建）
/prototype/checks_full_*.txt
/checks_full_*.txt

# ── 本地草稿 / 阶段性备份 / 需求原文（2026-11-19 上传前清理）──────────────
# 为什么：引擎仓库必须**不含任何具体项目内容**；需求原文、临时隔离目录、
# 诊断碎片、被删文件的暂存目录都属于"本机工作现场"，不属于引擎源码。
/_requirements/
/prototype/.removed_*/
/prototype/.tmp_*/
/prototype/_logs/
/prototype/_fix_acct.py
/prototype/checks_last.txt
/prototype/diag*.json
/prototype/proto.db
/prototype/web/_mv2.py
/开发文档.md.bak-*

# 本机设置备份（含曾经的 key 掩码与个人配置）
/prototype/data/settings.json*

# 第三方无障碍扫描库（axe-core，541K）：不随仓库分发。
# core/browser.py 取不到就**跳过 a11y 扫描**（不阻塞主流程）；
# 需要 D7 的 a11y 检查时自行下载放到 prototype/data/axe.min.js。
# 另外它内部大量 18 位数字串会被隐私扫描误判成身份证号，入库只会制造噪声。
/prototype/data/axe.min.js

# 本地阶段性备份（.bak-时间戳）一律不入库
/prototype/checks/*.bak-*
/*.bak-*

# 引擎本地的临时区归档（2026-11-19）：产物仓 .sixcoder/tmp 收尾时搬到这里备用。
# 按仓库指纹分目录，删任务/仓库记录时一并清；**绝不入库**（随时可能上百 MB）。
/prototype/data/scratch/

# 打包时生成的空白设置模板（不含 key，但每次构建都重新生成）
/packaging/settings.template.json

# 运行期数据库与临时工作区（不入库）
/data/
/.tmp_home3/
/.tmp_scgit/

# 一次性诊断脚本（不入库）
/.tmp_probe/
