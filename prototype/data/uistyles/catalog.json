{
 "version": "1",
 "description": "UI 审美样式库：列举页面/背景/菜单/按钮四类维度的全部类型，组合成 10 个风格预设。颜色一律是用户自填插槽（color_slots），库里不写死任何色值——只给语义与占位键，避免把'好不好看'的判据伪造成引擎可判。",
 "dimensions": ["page", "background", "menu", "button"],
 "color_slots": [
  {"key": "primary", "label": "主色", "hint": "品牌/主操作色，如 #4F8CFF"},
  {"key": "bg", "label": "背景色", "hint": "页面底色，如 #0E1117"},
  {"key": "surface", "label": "表面色", "hint": "卡片/面板底色，如 #161B22"},
  {"key": "text", "label": "正文色", "hint": "正文文字色，如 #E6EDF3"},
  {"key": "accent", "label": "强调色", "hint": "链接/高亮色，如 #FF6B6B"},
  {"key": "border", "label": "描边色", "hint": "分割线/边框色，如 #30363D"}
 ],
 "types": {
